# ===========================================================
# บัญชี / ไฟล์ XML ที่บอทย้ายไปมา - เป็นข้อมูลของเครื่องแต่ละเครื่อง
# ไม่ควรขึ้น GitHub (เยอะมากและเปลี่ยนตลอดเวลา)
# ===========================================================
backup/
backup-id/
backup-xml/
backup-fail/
input/
input-id/
zip-input/
login-success/
7day-check/
login-failed/
login-fail/
random-fail/
not-found/
unknown/
kaiby/
dead/
ranger-locks/

# XML บัญชีที่หลุดมาอยู่นอกโฟลเดอร์
/*.xml

# ===========================================================
# ไฟล์ชั่วคราว / สถานะตอนรัน - สร้างใหม่ได้เอง
# ===========================================================
__pycache__/
*.pyc
*.pyo

shared_stats.json
log.txt

# ภาพหน้าจอที่ dump ไว้ตอน debug
debug_ocr/
debug-timeout/
screen-*.png
_diag*.png
_verify*.png

# ===========================================================
# minitouch binaries - ผู้ใช้แต่ละคนหามาใส่เอง (ดู bin/minitouch/README.md)
# ===========================================================
bin/minitouch/*/

# API credentials - ห้าม push (มี cookie บัญชีจริง)
creds.json
creds.part*.json
creds*.lock
creds*.tmp
creds*.json*
creds.json.bak

# per-device working folder (runtime)
_processing/

# WireGuard config ต่อจอ (มีกุญแจบัญชี Windscribe) + ไฟล์แอป - ห้ามขึ้น git
wg/*
!wg/README.txt
wg_accounts/
# ตัวติดตั้งกุญแจ VPN ต่อบัญชี (มีกุญแจบัญชีอยู่ข้างใน) - ห้ามขึ้น git
install_account*.bat
logs/
wg_jp/
wg_new/
wg_test/
